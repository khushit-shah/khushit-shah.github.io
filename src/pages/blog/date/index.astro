---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

const posts = (await getCollection("blog"))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const yearsSet = new Set<string>();
for (const p of posts) {
  yearsSet.add(p.data.date.getFullYear().toString());
}
const years = Array.from(yearsSet).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title="Archives by date" description="Blog posts by year">
  <Container>
    <div class="space-y-6">
      <div class="animate font-semibold text-black dark:text-white">Archives</div>
      {years.length === 0 ? (
        <p>No posts available.</p>
      ) : (
        <ul class="flex flex-col gap-2">
          {years.map(year => (
            <li>
              <a href={`/blog/date/${year}`} class="hover:underline">{year}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</PageLayout>
