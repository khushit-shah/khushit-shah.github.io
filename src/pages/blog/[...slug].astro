---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Giscus from "@components/Giscus.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();

// compute tag counts for display next to tags on the post page
const allPosts = (await getCollection("blog")).filter(p => !p.data.draft);
const tagMap: Record<string, number> = {};
for (const p of allPosts) {
  const tags = p.data.tags ?? [];
  for (const t of tags) tagMap[t] = (tagMap[t] ?? 0) + 1;
}
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="animate mt-2">
          <div class="text-sm font-medium text-gray-600 dark:text-gray-300">Tags</div>
          <div class="flex flex-wrap gap-2 mt-2">
            {post.data.tags.map((tag) => (
              <a
                class="px-3 py-1 rounded bg-gray-100 text-sm text-gray-800 hover:underline dark:bg-gray-800 dark:text-gray-200"
                href={`/blog/tags/${encodeURIComponent(tag)}`}
              >
                {tag}
                <span class="ml-2 text-sm text-gray-600 dark:text-gray-400">({tagMap[tag] ?? 0})</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
    <Giscus />
  </Container>
</PageLayout>
